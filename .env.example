# Polyglot Localization Engine Environment Variables

# OpenAI API Key (Required for live gpt-4o-mini structured multi-variant generation)
OPENAI_API_KEY=your_openai_api_key_here

# Razorpay Credentials (Required for subscriptions and automatic API key issuance)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=

# Server Environment (set to 'production' to enforce strict API key auth)
ENV=development
